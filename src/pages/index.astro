---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site.config';
import ReviveSlot from '../components/ads/ReviveSlot.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft && (!data.lang || data.lang === 'fr'));
allPosts.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
const featuredPosts = allPosts.slice(0, 9);

const spots = [
  { name: 'Le Moule (La Bouelle)', type: 'Reef Break A-Frame', level: 'Expert', swell: 'Nord / Nord-Est', tide: 'Mi-marée montante', icon: '🌊' },
  { name: 'Anse Bertrand (La Chapelle)', type: 'Peak Gauche & Droite', level: 'Confirmé', swell: 'Nord / Est', tide: 'Toutes marées', icon: '⚡' },
  { name: 'Port-Louis (Le Souffleur)', type: 'Point Break Gauche', level: 'Tous niveaux', swell: 'Grosse houle Nord', tide: 'Basse à mi-marée', icon: '🌴' },
  { name: 'Bananier (Capesterre)', type: 'Beach Break Sable Noir', level: 'Débutant / Longboard', swell: 'Est / Sud-Est', tide: 'Toutes marées', icon: '🏄‍♂️' },
  { name: 'Le Helleux (Gros Sable)', type: 'Reef & Sable Multi-pics', level: 'Progression & Écoles', swell: 'Sud / Sud-Est', tide: 'Mi-marée', icon: '☀️' },
];
---

<Layout title="Surf Guadeloupe — Guide Officiel des Spots, Houle & Culture Glisse">
  <!-- Hero Section Brutalist Neo-Cyan -->
  <section class="relative overflow-hidden pt-12 pb-16 lg:py-24 border-b border-cyan-950/80 bg-gradient-to-b from-[#08192b] via-[#06111e] to-[#040a12]">
    <!-- Ambient Radial Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-5xl h-96 bg-gradient-to-b from-cyan-500/10 via-teal-500/5 to-transparent blur-3xl pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-950/80 border border-cyan-500/40 text-cyan-300 text-xs font-mono font-semibold tracking-wider uppercase mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          <span>Archipel Guadeloupe • Spots & Météo Marine</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-heading font-black text-white tracking-tight leading-[1.05] mb-6">
          LES PLUS BELLES <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-emerald-400">VAGUES</span> DES CARAÏBES.
        </h1>

        <p class="text-lg sm:text-xl text-slate-300 leading-relaxed font-normal mb-8">
          Du reef break de classe internationale du Moule aux beach breaks volcaniques de Bananier, découvrez le guide exhaustif des spots, la météo de la houle atlantique, les écoles certifiées et la culture glisse en Guadeloupe.
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a href="/blog/" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-cyan-500 to-teal-400 text-slate-950 font-heading font-bold text-sm tracking-wide shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:scale-[1.02] transition-all">
            Explorer les 200 Guides de Surf &rarr;
          </a>
          <a href="#spots" class="px-6 py-3.5 rounded-xl bg-[#0e2438] border border-cyan-800/60 text-cyan-200 font-semibold text-sm hover:bg-[#13304a] hover:text-white transition-colors">
            Voir la Carte des Spots
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- International Guides Banner (i18n Access) -->
  <section class="border-b border-cyan-950 bg-[#050e18] py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/en/" class="group p-5 rounded-2xl bg-gradient-to-br from-[#0a1e30] to-[#071522] border border-cyan-900/40 hover:border-cyan-400/60 transition-all flex items-center justify-between">
          <div>
            <div class="flex items-center space-x-2 mb-1">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-cyan-400">English Edition</span>
              <span class="text-[10px] bg-cyan-950 text-cyan-300 px-2 py-0.5 rounded border border-cyan-800">EN</span>
            </div>
            <h3 class="text-base font-heading font-bold text-white group-hover:text-cyan-300 transition-colors">
              Guadeloupe Surf Guide: Waves, Seasons & Reef Safety
            </h3>
            <p class="text-xs text-slate-400 mt-1">
              Discover top breaks, rental quivers, and groundswell forecasts for international riders.
            </p>
          </div>
          <span class="text-xl text-cyan-400 group-hover:translate-x-1 transition-transform ml-4">&rarr;</span>
        </a>

        <a href="/es/" class="group p-5 rounded-2xl bg-gradient-to-br from-[#0a1e30] to-[#071522] border border-cyan-900/40 hover:border-cyan-400/60 transition-all flex items-center justify-between">
          <div>
            <div class="flex items-center space-x-2 mb-1">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-cyan-400">Edición en Español</span>
              <span class="text-[10px] bg-cyan-950 text-cyan-300 px-2 py-0.5 rounded border border-cyan-800">ES</span>
            </div>
            <h3 class="text-base font-heading font-bold text-white group-hover:text-cyan-300 transition-colors">
              Guía de Surf en Guadalupe: Spots, Temporadas y Alquileres
            </h3>
            <p class="text-xs text-slate-400 mt-1">
              Todo lo que necesitas para surfear olas perfectas en el Caribe Francés.
            </p>
          </div>
          <span class="text-xl text-cyan-400 group-hover:translate-x-1 transition-transform ml-4">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Spots Lineup Overview -->
  <section id="spots" class="py-16 border-b border-cyan-950/80 bg-[#06111e]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-bold block mb-2">Lineup Report</span>
          <h2 class="text-2xl sm:text-4xl font-heading font-black text-white tracking-tight">
            Les 5 Spots Incontournables de l'Archipel
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-slate-400 max-w-md mt-2 md:mt-0">
          De la puissante houle du Nord qui réveille Port-Louis aux alizés d'Est de Grande-Terre, voici les points de chute indispensables.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {spots.map(s => (
          <div class="p-4 rounded-xl bg-[#091b2c] border border-cyan-900/50 hover:border-cyan-500/50 transition-colors flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xl">{s.icon}</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-950 text-cyan-300 border border-cyan-800">
                  {s.level}
                </span>
              </div>
              <h3 class="font-heading font-bold text-white text-sm mb-1">{s.name}</h3>
              <p class="text-[11px] text-cyan-400 font-mono mb-2">{s.type}</p>
            </div>
            <div class="pt-3 border-t border-cyan-950 text-[11px] text-slate-400 space-y-1">
              <div><strong class="text-slate-300">Houle :</strong> {s.swell}</div>
              <div><strong class="text-slate-300">Marée :</strong> {s.tide}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- In-Content Ad -->
  {siteConfig.revive?.zones?.inContent && (
    <div class="my-8 flex justify-center">
      <ReviveSlot format={siteConfig.revive.zones.inContent.format} zoneId={siteConfig.revive.zones.inContent.zoneId} />
    </div>
  )}

  <!-- Derniers Articles et Dossiers Surf -->
  <section class="py-16 bg-[#040a12]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between border-b border-cyan-950 pb-4 mb-10">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-bold block mb-1">Dépêches & Analyses</span>
          <h2 class="text-2xl sm:text-3xl font-heading font-black text-white">Dernières publications Surf Guadeloupe</h2>
        </div>
        <a href="/blog/" class="text-xs sm:text-sm font-bold text-cyan-400 hover:text-cyan-300 flex items-center space-x-1">
          <span>Tous les articles ({allPosts.length})</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredPosts.map(post => (
          <article class="p-6 rounded-2xl bg-[#071728] border border-cyan-950 hover:border-cyan-500/40 transition-all flex flex-col justify-between group shadow-sm">
            <div>
              <div class="flex items-center justify-between mb-3 text-[11px]">
                <span class="font-mono text-cyan-400 font-bold uppercase tracking-wider">
                  {post.data.category || 'Surf Report'}
                </span>
                <span class="text-slate-500">
                  {new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}
                </span>
              </div>

              <h3 class="text-lg font-heading font-bold text-white group-hover:text-cyan-300 transition-colors line-clamp-2 mb-3">
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h3>

              <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed mb-4">
                {post.data.description || 'Découvrez notre analyse détaillée des conditions de glisse, des compétitions et des spots en Guadeloupe.'}
              </p>
            </div>

            <div class="pt-4 border-t border-cyan-950/80 flex items-center justify-between text-xs">
              <span class="text-slate-500 font-mono">Par {post.data.author || 'Surf Guadeloupe'}</span>
              <a href={`/blog/${post.id}/`} class="font-semibold text-cyan-400 group-hover:translate-x-1 transition-transform inline-flex items-center space-x-1">
                <span>Lire</span>
                <span>&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a href="/blog/" class="inline-flex items-center space-x-2 px-8 py-3.5 rounded-xl bg-[#0c2236] border border-cyan-800 text-cyan-300 font-heading font-bold text-sm hover:bg-cyan-500 hover:text-slate-950 transition-all">
          <span>Consulter les {allPosts.length} articles & guides</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
