---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft && (!data.lang || data.lang === 'fr'));
posts.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
---

<Layout title="Tous les Guides & Articles de Surf | Surf Guadeloupe">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-12 pb-6 border-b border-cyan-950">
      <div class="flex items-center space-x-2 text-xs font-mono text-cyan-400 uppercase tracking-widest mb-2">
        <span>Archives Glisse & Météo</span>
        <span>•</span>
        <span>{posts.length} Publications</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-heading font-black text-white tracking-tight">
        Tous les Guides & Spots de Surf
      </h1>
      <p class="text-slate-400 text-sm sm:text-base mt-2 max-w-2xl">
        Consultez l'ensemble de nos reportages sur les reef breaks, beach breaks, analyses de houle et conseils pour surfer en Guadeloupe.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map(post => (
        <article class="p-6 rounded-2xl bg-[#071728] border border-cyan-950 hover:border-cyan-500/40 transition-all flex flex-col justify-between group shadow-sm">
          <div>
            <div class="flex items-center justify-between mb-3 text-[11px]">
              <span class="font-mono text-cyan-400 font-bold uppercase tracking-wider">
                {post.data.category || 'Surf Report'}
              </span>
              <span class="text-slate-500">
                {new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}
              </span>
            </div>

            <h2 class="text-base font-heading font-bold text-white group-hover:text-cyan-300 transition-colors line-clamp-2 mb-3">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>

            <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed mb-4">
              {post.data.description || 'Découvrez tous les détails, conditions et conseils de pratique dans ce dossier complet.'}
            </p>
          </div>

          <div class="pt-4 border-t border-cyan-950/80 flex items-center justify-between text-xs">
            <span class="text-slate-500 font-mono">Par {post.data.author || 'Surf Guadeloupe'}</span>
            <a href={`/blog/${post.id}/`} class="font-semibold text-cyan-400 group-hover:translate-x-1 transition-transform inline-flex items-center space-x-1">
              <span>Lire le guide</span>
              <span>&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
